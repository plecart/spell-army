# Chaîne de connexion Postgres lue par `pnpm --filter donnees run migrate` et par le serveur MCP
# local (`pnpm --filter web dev`). Valeur dans KeePassXC.
DATABASE_URL=

# Jeton du serveur MCP local, au moins 32 octets, sans quoi le serveur refuse tout appel. Le générer
# soi-même par `openssl rand -base64 32` (44 caractères), dans un terminal hors de l'app Claude, le
# ranger dans KeePassXC, puis l'écrire ici à la main. README, « Serveur MCP local ». La commande
# `pnpm --filter web deposer-3d` le présente au serveur de MCP_URL : c'est donc le jeton de ce
# serveur, local ou déployé.
MCP_TOKEN=

# Adresse du serveur MCP, local ou déployé, auquel `pnpm --filter web deposer-3d` envoie un fichier
# 3D : `http://127.0.0.1:3000/api/mcp` pour le serveur local. README, « Déposer un fichier 3D ».
MCP_URL=
