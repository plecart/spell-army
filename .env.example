# Chaîne de connexion Postgres lue par `pnpm --filter donnees run migrate`, par le serveur MCP local
# (`pnpm --filter web dev`) et par le tic de l'import. Valeur dans KeePassXC.
DATABASE_URL=

# Jeton du serveur MCP local, au moins 32 octets, sans quoi le serveur refuse tout appel. Le générer
# soi-même par `openssl rand -base64 32` (44 caractères), dans un terminal hors de l'app Claude, le
# ranger dans KeePassXC, puis l'écrire ici à la main. docs/exploitation.md, « Serveur MCP local ». La commande
# `pnpm --filter web deposer-3d` le présente au serveur de MCP_URL : c'est donc le jeton de ce
# serveur, local ou déployé.
MCP_TOKEN=

# Adresse du serveur MCP, local ou déployé, auquel `pnpm --filter web deposer-3d` envoie un fichier
# 3D : `http://127.0.0.1:3000/api/mcp` pour le serveur local. docs/exploitation.md, « Déposer un fichier 3D ».
MCP_URL=

# Secret du tic de l'import (`POST /api/tic`), au moins 32 octets comme MCP_TOKEN, sans quoi le tic
# refuse tout appel. Le générer de même par `openssl rand -base64 32`, dans un terminal hors de l'app
# Claude, le ranger dans KeePassXC, puis l'écrire ici à la main. En ligne, le mainteneur le saisit
# dans les réglages Vercel et, pour le filet du tic, dans les secrets GitHub Actions (ADR 0004,
# « Saisie »). docs/exploitation.md, « Tic de l'import ».
CRON_SECRET=

# Clé d'accès HikerAPI, le fournisseur de la liste des abonnés (ADR 0003, « Fournisseur »), lue par
# le tic de l'import et l'outil MCP relancer_passe. Secret : rangée dans KeePassXC, écrite ici à la
# main, hors de l'app Claude ; en ligne, saisie par le mainteneur dans les réglages Vercel (ADR 0004,
# « Saisie »).
HIKERAPI_ACCESS_KEY=

# Identifiant numérique du compte Instagram dont on lit les abonnés. Non secret, propre à chaque
# environnement : la pré-production et la production lisent deux comptes différents.
INSTAGRAM_ACCOUNT_ID=

# Pseudo de ce même compte, sans « @ », lu par le site public : le titre de l'annuaire (« L'armée de
# @compte »), le lien « Instagram » du pied et le contact de la page « Informations » y mènent.
# Absent ou hors de la forme d'un pseudo, le titre est « L'armée », sans lien. Non secret, propre à
# chaque environnement. docs/exploitation.md, « Site public ».
INSTAGRAM_ACCOUNT_HANDLE=

# Bandeau « BÊTA — version de test » en tête du site public, affiché quand la variable n'est pas vide
# (ADR 0004, « Bandeau bêta ») : posée en pré-production, vide en production. Non secrète.
BETA_BANNER=

# Chemin de blender.exe (Blender 5.3), lu par `pnpm --filter personnages modeles` et `rendus` ;
# facultatif si `blender` est dans le PATH. Pas un secret. docs/exploitation.md, « Fabriquer les modèles 3D ».
# BLENDER=C:\Program Files\Blender Foundation\Blender 5.3\blender.exe
