{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		// Next.js compile l'application et résout ses imports en bundler : TypeScript suit la même
		// résolution, celle d'un projet Next.js neuf (next 16.4.6 : `dist/docs/01-app/
		// 03-api-reference/08-turbopack.md`, « TypeScript » ; `dist/lib/typescript/
		// writeConfigurationDefaults.js`). Les sous-chemins de `next` s'y importent sans extension,
		// sous leur forme documentée (`next/server`, `next/link`). Les scripts de `scripts/`, exécutés
		// par Node, ont leur propre projet (`scripts/tsconfig.json`).
		"module": "esnext",
		"moduleResolution": "bundler"
	},
	"include": ["next-env.d.ts", ".next/types/**/*.ts", "app", "test", "*.ts"]
}
