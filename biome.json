{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/*.md",
			"!!.claude",
			"!skills-lock.json",
			"!**/migrations"
		]
	},
	"formatter": {
		"lineEnding": "lf"
	}
}
